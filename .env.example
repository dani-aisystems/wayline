# Wayline Клас environment variables.
# Local development: copy to .env.local (gitignored) and fill in. Production: set in Vercel project settings.
# Never commit real values. Without these, Wayline runs exactly as before; only the classroom layer is off.

# --- PUBLIC: compiled into the browser bundle (VITE_ prefix). Safe by design: row-level security protects the data.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co. Used by the browser and by /api functions.
VITE_SUPABASE_URL=

# Supabase publishable key (starts with sb_publishable_). Browser sign-in and RLS-scoped reads; /api/health.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- SERVER-ONLY: never prefix with VITE_, never expose to the browser. Not needed until Milestone B.

# Supabase secret key (starts with sb_secret_). BYPASSES row-level security. Used only by
# /api/admin/delete-student and scripts/seed-demo.ts. Vercel: Production scope only.
# SUPABASE_SECRET_KEY=
