{
  "name": "wayline",
  "version": "0.2.0",
  "description": "Free, local-first English course from Pre-A1 to C2: adaptive level test, personal daily plan, speaking practice and a growing library.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "Daniel Yanchev <daniel.aisystems@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/dani-aisystems/wayline.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src e2e",
    "test": "vitest run",
    "test:content": "vitest run src/content",
    "test:e2e": "playwright test",
    "brand": "python3 scripts/build-brand.py",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build:artifact": "vite build --mode artifact && python3 scripts/make-artifact.py dist-artifact/wayline.html"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
